# ===================================
# ALGORA — Ortam Değişkenleri (örnek)
# Kopyala: cp .env.example .env.local → değerleri doldur
# ===================================

# Supabase (zorunlu) — Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service-role (ZORUNLU, YALNIZCA SUNUCU) — abonelik/kredi/hesap-silme
# route'ları kullanır. ASLA NEXT_PUBLIC_ önekiyle açma, istemciye gönderme!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini API (zorunlu) — soru üretimi (app/api/questions/generate)
GEMINI_API_KEY=your_gemini_api_key

# Admin API anahtarı (zorunlu, sunucu) — ödeme talep onay/reject uçları
# (rastgele üret: openssl rand -hex 32)
ADMIN_SECRET_KEY=your_random_admin_secret

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (Google ile giriş kullanılıyorsa)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# NOT (O7 temizliği): OPENAI_API_KEY ve BREVO_API_KEY KALDIRILDI —
# üretim kodunda kullanılmıyorlar (soru üretimi Gemini, e-posta Supabase native).
